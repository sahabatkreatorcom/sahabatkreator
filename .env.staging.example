# ============================================================
# Sahabat Kreator — STAGING (app.sahabatkreator.com)
# Dipakai oleh: docker-compose.staging.yml (env_file)
#
#   cp .env.staging.example .env.staging   # lalu isi nilainya
#
# ⚠️ JANGAN commit .env.staging — sudah masuk .gitignore.
# ⚠️ Nilai kosong dianggap undefined (emptyStringAsUndefined).
# ⚠️ Gunakan proyek Neon STAGING terpisah — jangan arahkan ke DB produksi.
# ============================================================

# ---------- Core ----------
NODE_ENV=production
# Public URL aplikasi web (domain staging)
WEB_URL=https://app.sahabatkreator.com
# Public URL server API (satu domain dengan web — hono serve static + API)
SERVER_URL=https://app.sahabatkreator.com
# Origin web yang diizinkan (CORS) — harus sama dengan WEB_URL
CORS_ORIGIN=https://app.sahabatkreator.com
# Secret better-auth (min 32 karakter, generate: openssl rand -base64 32)
# Gunakan secret BERBEDA dari produksi agar session staging tidak valid di prod.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.sahabatkreator.com

# ---------- Database (Neon Serverless Postgres — STAGING terpisah) ----------
# Ambil connection string dari dashboard Neon (proyek STAGING, bukan prod).
# URL Neon sudah menyertakan ?sslmode=require — JANGAN ditambah lagi.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- Worker & queue ----------
# REDIS_URL otomatis di-set compose (redis://redis:6379) — biarkan kosong.
REDIS_URL=
WORKER_PORT=3001

# ---------- Lainnya ----------
# Secret cron/internal endpoint (generate: openssl rand -base64 32)
CRON_SECRET=
# AES-256-GCM key base64 32-byte (generate: openssl rand -base64 32) —
# gunakan key BERBEDA dari produksi agar data terenkripsi tidak terbaca lintas env.
ENCRYPTION_KEY=

# ---------- Email (Resend) ----------
# Kosongkan di staging → fallback log console (tidak kirim email sungguhan).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sahabat Kreator <noreply@sahabatkreator.com>

# ---------- Storage (Cloudflare R2) ----------
# Disarankan bucket staging terpisah agar media uji tidak mencemari bucket prod.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- Billing (Sumopod Pay) ----------
# Staging pakai sandbox
SUMOPOD_API_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_TOKEN=
# Sandbox menolak non-HTTPS — biarkan kosong (default pakai WEB_URL staging).
SUMOPOD_RETURN_BASE_URL=

# ---------- AI (OpenRouter, opsional) ----------
OPENROUTER_API_KEY=

# ---------- Social platform API (versi & host) ----------
META_GRAPH_VERSION=v26.0
LINKEDIN_API_VERSION=202608
BLUESKY_PDS_URL=https://bsky.social
# Sandbox Pinterest (Trial Access belum bisa publish production):
# set ke https://api-sandbox.pinterest.com/v5 lalu hubungkan ulang akun Pinterest
# (token production tidak berlaku di sandbox). Kembalikan ke api.pinterest.com
# setelah Standard Access di-approve.
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5

# ---------- OAuth kredensial platform ----------
# Bisa dipakai app dev yang sama asalkan redirect URI staging
# (https://app.sahabatkreator.com/...) terdaftar di developer console.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Scope ekstra TikTok — isi HANYA setelah product Comment API di-approve
TIKTOK_EXTRA_SCOPES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# App LinkedIn KEDUA — product Community Management API (halaman company).
# Product itu WAJIB jadi satu-satunya product di app-nya (FAQ resmi) → app & callback
# terpisah dari app personal di atas: {SERVER_URL}/api/oauth/linkedin_org/callback
# Flow ini hanya menawarkan halaman company (tidak ada profil person — app tanpa `openid`).
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
# Scope organization LinkedIn ekstra untuk app PERSONAL — kosongkan sampai app
# Community Management API (app LinkedIn kedua) di-approve. Scope company sudah
# bawaan platform `linkedin_org`. Lihat docs/social-platforms/linkedin.md.
LINKEDIN_EXTRA_SCOPES=

# ---------- Webhook verify token ----------
META_WEBHOOK_VERIFY_TOKEN=
THREADS_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---------- Web Push (VAPID) ----------
VAPID_CONTACT_EMAIL=Sahabat Kreator <support@sahabatkreator.com>
MODAL_TOKEN=
MODAL_FUNCTION_URL=