# ============================================================
# Sahabat Kreator — Single Source of Truth Environment
# Copy file ini ke .env lalu isi nilainya. JANGAN membuat .env lain di sub-folder.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
# Public URL aplikasi web
WEB_URL=http://localhost:5173
# Public URL server API
SERVER_URL=http://localhost:3000
# Origin web yang diizinkan (CORS) — harus sama dengan WEB_URL
CORS_ORIGIN=http://localhost:5173
# Secret better-auth (min 32 karakter, generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter!!
BETTER_AUTH_URL=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahabatkreator

# ---------- Email (Resend) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sahabat Kreator <noreply@sahabatkreator.com>

# ---------- Storage (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix untuk file R2 (mis. custom domain / R2 public bucket)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ---------- Billing (Sumopod Pay) ----------
SUMOPOD_API_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_TOKEN=
# Optional: override base URL halaman return billing (sandbox menolak non-HTTPS).
# Kosongkan di production — default pakai WEB_URL.
SUMOPOD_RETURN_BASE_URL=

# ---------- AI (OpenRouter, opsional) ----------
OPENROUTER_API_KEY=

# ---------- Social platform API (versi & host) ----------
# Meta Graph API version (docs: https://developers.facebook.com)
META_GRAPH_VERSION=v26.0
# LinkedIn API version — sunset bulanan, update rutin
LINKEDIN_API_VERSION=202608
# Bluesky PDS host untuk publishing
BLUESKY_PDS_URL=https://bsky.social
# Pinterest API base URL
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5

# ---------- OAuth kredensial platform ----------
# Fallback bila belum diisi admin via Admin Panel → Kredensial Platform.
# Instagram (akun bisnis) & Facebook memakai satu aplikasi Meta.
META_APP_ID=
META_APP_SECRET=
# Instagram standalone (Instagram Login) — app terpisah dari Meta
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads — app terpisah (developers.threads.net)
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube & Google Business Profile (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Scope organization LinkedIn ekstra (posting sebagai company / multi-company).
# Biarkan KOSONG sampai product LinkedIn (Community Management API dsb.) di-approve —
# scope tak terdaftar di app membuat consent ditolak invalid_scope.
# Setelah approval: LINKEDIN_EXTRA_SCOPES=r_organization_admin w_organization_social
LINKEDIN_EXTRA_SCOPES=

# ---------- Webhook verify token ----------
# Token handshake GET (hub.verify_token) saat subscribe webhook di developer console.
# Instagram (akun bisnis via FB Login) & Facebook — satu aplikasi Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Threads — aplikasi terpisah (developers.threads.net)
THREADS_WEBHOOK_VERIFY_TOKEN=
# Instagram Login standalone — aplikasi terpisah dari Meta app utama
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---------- Web Push (VAPID) ----------
# Kontak admin untuk push service (mailto). VAPID keypair digenerate
# otomatis oleh admin panel — yang ini hanya identitas kontak.
VAPID_CONTACT_EMAIL=Sahabat Kreator <support@sahabatkreator.com>

# ---------- Worker & queue ----------
# Port worker publisher (fallback cron + health check)
WORKER_PORT=3001
# Redis untuk BullMQ publish queue. Kosong = fallback DB polling di worker.
REDIS_URL=

# ---------- Lainnya ----------
# Secret untuk cron/internal endpoint (generate acak)
CRON_SECRET=
# AES-256-GCM key base64 32-byte untuk enkripsi kredensial platform (generate: openssl rand -base64 32)
ENCRYPTION_KEY=
