# =============================================================================
# Sahabat Kreator — Single Source of Truth Environment
# Salin ke `.env` di root repo dan isi. Jangan commit file `.env`.
# Semua konsumen (web, worker, tooling DB, docker compose) membaca file ini
# via `packages/env` (loadRootEnv). Validasi zod di packages/env/src/server.ts.
# =============================================================================

# --- Domain (produksi, untuk Caddy SSL) ---
# Wajib diisi & arahkan DNS (A record) ke IP VPS sebelum `docker compose up`.
DOMAIN=sahabat-kreator.com

# --- Database ---
# Dev (Neon):  postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require
# Prod (Docker postgres): postgres://sahabat:sahabat_password@postgres:5432/sahabat
DATABASE_URL=
# DATABASE_SSL=true            # Neon bila URL belum menyertakan sslmode (hanya untuk drizzle-kit)

# --- Postgres (service docker compose) — TIDAK diekspos ke host, hanya antar-service ---
# POSTGRES_USER=sahabat
# POSTGRES_PASSWORD=sahabat_password
# POSTGRES_DB=sahabat

# --- Auth & URL ---
BETTER_AUTH_SECRET=            # minimal 32 karakter
BETTER_AUTH_URL=
CORS_ORIGIN=
NEXT_PUBLIC_APP_URL=

# --- Keamanan (WAJIB di production) ---
ENCRYPTION_KEY=                # base64 32 byte (openssl rand -base64 32). Set sekali.
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Logging ---
LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal

# --- Job queue (BullMQ / Redis) — opsional ---
# REDIS_URL=redis://redis:6379
# QUEUE_WORKER_ENABLED=true

# --- Storage (Cloudflare R2) — WAJIB untuk fitur media ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CUSTOM_DOMAIN=              # opsional; URL publik media

# --- Payment SumoPod ---
# Konfigurasi (api key, webhook secret/token) di tabel `global_integration_settings`
# via admin panel — BUKAN lewat env.

# --- Stock media ---
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# --- AI (Seb / OpenRouter) ---
OPENROUTER_API_KEY=

# --- Webhook platform (fallback — prioritas: DB via admin panel /admin/platforms) ---
# Setelah kredensial diisi di admin panel, secret berikut TIDAK wajib.
# META_APP_SECRET=          # App Secret Meta (verifikasi X-Hub-Signature-256)
# WEBHOOK_VERIFY_TOKEN=     # Verify token handshake (Meta hub.verify_token / YouTube)

# --- Platform OAuth (fallback bila global_platform_credential di DB belum diisi) ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# --- GitHub OAuth (social login) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Worker media ---
# VPS kecil (2 core/4GB): pakai batch=1 & poll lebih lama agar ffmpeg tidak
# menumpuk; video > WORKER_MAX_VIDEO_BYTES hanya dibuat poster (tanpa transcode).
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=1
WORKER_FRAME_COUNT=4
WORKER_MAX_VIDEO_BYTES=104857600
WORKER_ENABLE_TRANSCODE=true
# Implementasi transcoder: "local" (ffmpeg) = default. "modal" belum tersedia.
TRANSCODER=local
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Testing (e2e) — opsional, file terpisah apps/web/.env.e2e ---
# TEST_EMAIL=
# TEST_PASSWORD=
