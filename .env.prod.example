# ============================================================
# Sahabat Kreator — PRODUKSI (sahabatkreator.com)
# Dipakai oleh: docker-compose.prod.yml (env_file)
#
#   cp .env.prod.example .env.prod   # lalu isi nilainya
#
# ⚠️ JANGAN commit .env.prod — sudah masuk .gitignore.
# ⚠️ Nilai kosong dianggap undefined (emptyStringAsUndefined).
# ============================================================

# ---------- Core ----------
NODE_ENV=production
# Public URL aplikasi web
WEB_URL=https://sahabatkreator.com
# Public URL server API (satu domain dengan web — hono serve static + API)
SERVER_URL=https://sahabatkreator.com
# Origin web yang diizinkan (CORS) — harus sama dengan WEB_URL
CORS_ORIGIN=https://sahabatkreator.com
# Secret better-auth (min 32 karakter, generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://sahabatkreator.com
# Google Analytics 4 Measurement ID (G-XXXXXXX) — build arg Docker (GA_MEASUREMENT_ID).
# Kosong → GA tidak dimuat di frontend.
GA_MEASUREMENT_ID=

# ---------- Database (PostgreSQL 18 container di server) ----------
# Service "postgres" (docker-compose.prod.yml) memakai kredensial ini.
# DATABASE_URL TIDAK diisi di sini — di-set otomatis oleh compose
# mengarah ke container postgres (jaringan internal).
# Password DB produksi — WAJIB URL-safe karena di-embed ke DATABASE_URL.
# Generate: openssl rand -hex 24
# ⚠️ JANGAN openssl rand -base64 — karakter + / = merusak parsing URL koneksi.
POSTGRES_PASSWORD=
# Cadangan manual (docker exec) — biarkan kosong:
# DATABASE_URL=postgresql://sahabatkreator:<POSTGRES_PASSWORD>@postgres:5432/sahabatkreator

# ---------- Worker & queue ----------
# REDIS_URL otomatis di-set compose (redis://redis:6379) — biarkan kosong.
REDIS_URL=
# Port worker publisher di dalam container (tidak dipublish ke host)
WORKER_PORT=3001

# ---------- Lainnya (WAJIB diisi di produksi) ----------
# Secret cron/internal endpoint (generate: openssl rand -base64 32)
CRON_SECRET=
# AES-256-GCM key base64 32-byte untuk enkripsi kredensial platform
# (generate: openssl rand -base64 32) — wajib agar token OAuth user terenkripsi
ENCRYPTION_KEY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sahabat Kreator <noreply@sahabatkreator.com>

# ---------- Storage (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix untuk file R2 (mis. custom domain / R2 public bucket)
R2_PUBLIC_URL=

# ---------- Billing (Sumopod Pay) ----------
# Gunakan base URL production Sumopod (bukan sandbox)
SUMOPOD_API_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_TOKEN=
# Kosongkan di production — default pakai WEB_URL
SUMOPOD_RETURN_BASE_URL=

# ---------- AI (OpenRouter, opsional) ----------
OPENROUTER_API_KEY=

# ---------- Social platform API (versi & host) ----------
META_GRAPH_VERSION=v26.0
# LinkedIn API version — sunset bulanan, update rutin
LINKEDIN_API_VERSION=202608
BLUESKY_PDS_URL=https://bsky.social
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5

# ---------- OAuth kredensial platform ----------
# Fallback bila belum diisi admin via Admin Panel → Kredensial Platform.
# Pastikan redirect URI di developer console masing-masing sudah
# mendaftarkan https://sahabatkreator.com/...
META_APP_ID=
META_APP_SECRET=
# Instagram standalone (Instagram Login) — app terpisah dari Meta
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads — app terpisah (developers.threads.net)
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Scope ekstra TikTok — isi HANYA setelah product Comment API di-approve
TIKTOK_EXTRA_SCOPES=
# YouTube & Google Business Profile (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# App LinkedIn KEDUA — product Community Management API (halaman company).
# Product itu WAJIB jadi SATU-SATUNYA product di app-nya → app & callback terpisah
# dari app personal di atas: {SERVER_URL}/api/oauth/linkedin_org/callback
# Flow ini hanya menawarkan halaman company (tidak ada profil person — app tanpa `openid`).
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
# Scope organization LinkedIn ekstra untuk app PERSONAL — KOSONGKAN selama app
# LinkedIn belum punya product Community Management API (scope tak terdaftar →
# invalid_scope). Scope company sudah bawaan platform `linkedin_org`;
# lihat docs/social-platforms/linkedin.md.
LINKEDIN_EXTRA_SCOPES=

# ---------- Webhook verify token ----------
META_WEBHOOK_VERIFY_TOKEN=
THREADS_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---------- Web Push (VAPID) ----------
VAPID_CONTACT_EMAIL=Sahabat Kreator <support@sahabatkreator.com>
