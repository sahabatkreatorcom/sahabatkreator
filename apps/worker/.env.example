# Sama dengan apps/web/.env — worker butuh env yang sama (db, R2).
# Salin dari .env prod atau web.
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
CORS_ORIGIN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CUSTOM_DOMAIN=

# Opsional
WORKER_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=3
WORKER_FRAME_COUNT=4
WORKER_MAX_VIDEO_BYTES=104857600
WORKER_ENABLE_TRANSCODE=true
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
