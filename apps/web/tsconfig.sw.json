{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "lib": ["ESNext", "WebWorker"],
    // Service worker juga dibangun Vite — jangan pernah emit .js di samping src.
    "noEmit": true
  },
  "include": ["src/sw.ts"]
}
