{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "rootDirs": ["."],
    // Tanpa noEmit, `tsc` tanpa flag (mis. `bunx tsc` / `tsc -b` yang salah
    // target) memuntahkan .js di samping tiap source. Vite yang membangun app
    // ini, bukan tsc — jadi emit di sini tidak pernah dibutuhkan.
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["src/sw.ts"]
}
