{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "verify:integrations": "bun scripts/verify-integrations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@hono/zod-openapi": "^1.6.1",
    "@sahabatkreator/api": "workspace:*",
    "@sahabatkreator/auth": "workspace:*",
    "@sahabatkreator/db": "workspace:*",
    "@sahabatkreator/env": "workspace:*",
    "@sahabatkreator/publishing": "workspace:*",
    "@sahabatkreator/queue": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "resend": "^6.22.0",
    "sharp": "^0.35.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sahabatkreator/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
